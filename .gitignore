MANIFEST

# PyInstaller
#  Usually these files are written by a python script, and contain the binarized
#  version of a module to optimize loading time. PyInstaller gives a list of
#  files to exclude in its .spec file, so this is just a backup.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypotheses/
.pytest_cache/
cover/

